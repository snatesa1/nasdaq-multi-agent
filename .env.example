# ============================================================
# NASDAQ Multi-Agent & OptionsLab — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit the actual .env file to version control.
# ============================================================

# ── Saxo OpenAPI Broker ──────────────────────────────────────
SAXO_APP_KEY=your_saxo_app_key_here
SAXO_APP_SECRET=your_saxo_app_secret_here
SAXO_REDIRECT_URL=http://localhost:8000/api/broker/oauth/callback
SAXO_ENV=LIVE
# Runtime tokens (auto-managed, leave empty on first setup)
SAXO_ACCESS_TOKEN=
SAXO_REFRESH_TOKEN=
BROKER_ALLOW_LIVE_EXECUTION=false

# ── Market Data Feeds ────────────────────────────────────────
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
FRED_API_KEY=your_fred_api_key_here
FMP_API_KEY=your_fmp_api_key_here

# ── AI / LLM Integration ────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
VERTEX_KEY=
VERTEX_MODEL=gemini-2.5-flash
DISABLE_VERTEX_FALLBACK=True

# ── Runtime & Database ───────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DB_DATA_DIR=./options_lab
NAS_BACKUP_DIR=./backups

# ── Google Cloud Platform ────────────────────────────────────
GCP_PROJECT_ID=optimal-aurora-495912-n0
GOOGLE_CLOUD_PROJECT=optimal-aurora-495912-n0
FIREBASE_PROJECT_ID=optimal-aurora-495912-n0

# ── Notifications & Scheduler ────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your_slack_signing_secret
SLACK_CHANNEL_ID=your_slack_channel_id
CRON_SECRET=your_cron_secret
EMAIL_SENDER=your_email@gmail.com
EMAIL_RECIPIENT=recipient@gmail.com
EMAIL_APP_PASSWORD=your_app_password
